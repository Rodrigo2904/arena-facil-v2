# Banco de dados
# Desenvolvimento (SQLite, não precisa instalar nada):
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL) — troque também o provider em prisma/schema.prisma:
# DATABASE_URL="postgresql://usuario:senha@host:5432/arena_facil"

# Segredo usado para assinar o cookie de sessão.
# Gere um valor aleatório: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres"
